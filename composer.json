{
    "name": "mdestafadilah/aapanelapi",
    "description": "PHP client for the aaPanel panel API v2 (websites, domains, SSL and MySQL databases). Maintained fork of mythicalsystems/aapanelapi.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/mdestafadilah/AAPanel-API",
    "keywords": [
        "aapanel",
        "aapanel-api",
        "aapanel-php",
        "aapanel-v2",
        "mdestafadilah",
        "mythicalsystems",
        "nayskutzu"
    ],
    "autoload": {
        "psr-4": {
            "MythicalSystems\\AaPanelApi\\": "src/"
        }
    },
    "authors": [
        {
            "name": "mdestafadilah",
            "email": "desta.08b@gmail.com",
            "role": "Maintainer"
        },
        {
            "name": "NaysKutzu",
            "email": "ghermancassian2008@gmail.com",
            "role": "Original author (mythicalsystems/aapanelapi)"
        },
        {
            "name": "skolastikarhea",
            "homepage": "https://github.com/skolastikarhea",
            "role": "Original author (api_aapanel)"
        }
    ],
    "support": {
        "issues": "https://github.com/mdestafadilah/AAPanel-API/issues",
        "source": "https://github.com/mdestafadilah/AAPanel-API"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Optional transport (^7.0) if you prefer Guzzle over the bundled cURL transport"
    },
    "scripts": {
        "test": "php tests/smoke.php"
    },
    "config": {
        "sort-packages": true
    }
}
